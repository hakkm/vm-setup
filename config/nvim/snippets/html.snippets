snippet precodepy
	<pre>
		<code class="python">
			$0
		</code>
	</pre>

snippet !html
	<!DOCTYPE html>
	<html>
		<head>
			<title>$1</title>
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
		</head>
		<body>
			$2
		</body>
	</html>

snippet scriptsrc
	<script src="$1"></script>

snippet tailwindcdn
    <script src="https://cdn.tailwindcss.com"></script>
